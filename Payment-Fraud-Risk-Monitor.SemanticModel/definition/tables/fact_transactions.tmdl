	partition fact_transactions = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_transactions.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    BlankToNull = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(BlankToNull, {{"TransactionID", type text}, {"DateKey", Int64.Type}, {"MerchantKey", Int64.Type}, {"CustomerID", type text}, {"PaymentMethod", type text}, {"GrossAmountEUR", Currency.Type}, {"CardCountry", type text}, {"IPCountry", type text}, {"DeviceType", type text}, {"Is3DS", type logical}, {"AccountAgeDays", Int64.Type}, {"TxnLast24h", Int64.Type}, {"RiskScore", type number}, {"Decision", type text}, {"IsFraud", type logical}, {"IsChargeback", type logical}, {"ChargebackReason", type text}, {"ChargebackDateKey", Int64.Type}, {"ChargebackFeeEUR", Currency.Type}}, "en-US"),
				    GeoMismatch = Table.AddColumn(Typed, "GeoMismatch", each [CardCountry] <> [IPCountry], type logical),
				    AgeBand = Table.AddColumn(GeoMismatch, "AccountAgeBand", each if [AccountAgeDays] < 14 then "0-13 days" else if [AccountAgeDays] < 90 then "14-89 days" else if [AccountAgeDays] < 365 then "90-364 days" else "1y+", type text),
				    Final = Table.AddColumn(AgeBand, "RiskBand", each if [RiskScore] >= 80 then "Critical" else if [RiskScore] >= 55 then "High" else if [RiskScore] >= 30 then "Medium" else "Low", type text)
				in
				    Final

