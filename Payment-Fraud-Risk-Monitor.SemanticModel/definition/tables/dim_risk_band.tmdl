	partition dim_risk_band = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_risk_band.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    BlankToNull = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(BlankToNull, {{"BandOrder", Int64.Type}, {"RiskBand", type text}, {"MinScore", Int64.Type}, {"MaxScore", type number}}, "en-US"),
				    Final = Typed
				in
				    Final

