	column MerchantID
		dataType: string
		lineageTag: 09d24a69-951b-45a1-a787-55f4b33dbee4
		summarizeBy: none
		sourceColumn: MerchantID

	column MerchantName
		dataType: string
		lineageTag: e6da8d9c-2631-41e6-8191-27b9939a28dc
		summarizeBy: none
		sourceColumn: MerchantName

	column Category
		dataType: string
		lineageTag: 4ffbbed6-d723-4d35-a04f-c04adb94c80c
		summarizeBy: none
		sourceColumn: Category

	column CountryCode
		dataType: string
		lineageTag: 74e560d3-e695-401a-b304-73c1539a9af1
