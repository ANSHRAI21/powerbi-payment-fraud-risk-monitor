	partition dim_merchant = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_merchant.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    BlankToNull = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(BlankToNull, {{"MerchantKey", Int64.Type}, {"MerchantID", type text}, {"MerchantName", type text}, {"Category", type text}, {"CountryCode", type text}, {"Region", type text}, {"Tier", type text}}, "en-US"),
				    Final = Typed
				in
				    Final

